'use strict';

import type {ViewProps} from '../View/ViewPropTypes';

import * as React from 'react';

export type PredictiveBackNativeEvent = {
  progress: number,
  swipeEdge: number,
  touchX: number,
  touchY: number,
  phase: number,
};

export type PredictiveBackAnimatedViewProps = {
  ...ViewProps,
  onProgress?: (event: {nativeEvent: PredictiveBackNativeEvent}) => mixed,
};

declare const PredictiveBackAnimatedView: React.AbstractComponent<PredictiveBackAnimatedViewProps>;

declare export default typeof PredictiveBackAnimatedView;
