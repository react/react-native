import type {
  CodegenTypes,
  ColorValue,
  EdgeInsetsValue,
  HostComponent,
  PointValue,
  RootTag,
  ViewProps,
} from 'react-native';

import {codegenNativeCommands, codegenNativeComponent} from 'react-native';

type NativeProps = Readonly<{
  ...ViewProps,
  bool: boolean,
  string: string,
  double: CodegenTypes.Double,
  float: CodegenTypes.Float,
  int: CodegenTypes.Int32,
  mixed: CodegenTypes.UnsafeMixed,

  optionalBool?: CodegenTypes.WithDefault<boolean, false>,
  optionalString?: CodegenTypes.WithDefault<string, ''>,
  optionalStringDiffDefault?: CodegenTypes.WithDefault<string, 'default'>,
  optionalDouble?: CodegenTypes.WithDefault<CodegenTypes.Double, 0.0>,
  optionalFloat?: CodegenTypes.WithDefault<CodegenTypes.Float, 0.0>,
  optionalInt?: CodegenTypes.WithDefault<CodegenTypes.Int32, 0>,

  reserverdEdgeInsets: EdgeInsetsValue,
  reservedPointValue: PointValue,

  stringUnion?: CodegenTypes.WithDefault<'foo' | 'bar', 'bar'>,
  intUnion?: CodegenTypes.WithDefault<1 | 2, 1>,

  nestedObject: Readonly<{
    string: string,
    color: ColorValue,
  }>,

  nestedObjectChanged: Readonly<{
    string: boolean,
    color: ColorValue,
  }>,

  arrayStringUnion?: CodegenTypes.WithDefault<
    ReadonlyArray<'foo' | 'bar'>,
    'foo',
  >,
  arrayStringUnionExtra?: CodegenTypes.WithDefault<
    ReadonlyArray<'foo' | 'bar' | 'baz'>,
    'bar',
  >,

  arrayNestedObject: ReadonlyArray<
    Readonly<{
      string: string,
      color: ColorValue,
    }>,
  >,

  arrayNestedObjectChange: ReadonlyArray<
    Readonly<{
      string: boolean,
      color: ColorValue,
    }>,
  >,
}>;

type NativeType = HostComponent<NativeProps>;

type Int = CodegenTypes.Int32;
type Str = string;
type Bool = boolean;
type Fl = CodegenTypes.Float;
type Dbl = CodegenTypes.Double;
type CustomObj = {foo: string, bar: number};
type CustomObj2 = {a: CodegenTypes.Int32, b: string};

interface NativeCommands {
  readonly methodInt: (
    viewRef: React.ElementRef<NativeType>,
    a: CodegenTypes.Int32,
  ) => void;
  readonly methodIntString: (
    viewRef: React.ElementRef<NativeType>,
    a: CodegenTypes.Int32,
    b: string,
  ) => void;
  readonly methodString: (
    viewRef: React.ElementRef<NativeType>,
    a: string,
  ) => void;
  readonly methodBool: (
    viewRef: React.ElementRef<NativeType>,
    a: boolean,
  ) => void;
  readonly methodFloat: (
    viewRef: React.ElementRef<NativeType>,
    a: CodegenTypes.Float,
  ) => void;
  readonly methodDouble: (
    viewRef: React.ElementRef<NativeType>,
    a: CodegenTypes.Double,
  ) => void;

  readonly methodIntAlias: (
    viewRef: React.ElementRef<NativeType>,
    a: Int,
  ) => void;
  readonly methodStringAlias: (
    viewRef: React.ElementRef<NativeType>,
    a: Str,
  ) => void;
  readonly methodBoolAlias: (
    viewRef: React.ElementRef<NativeType>,
    a: Bool,
  ) => void;
  readonly methodFloatAlias: (
    viewRef: React.ElementRef<NativeType>,
    a: Fl,
  ) => void;
  readonly methodDoubleAlias: (
    viewRef: React.ElementRef<NativeType>,
    a: Dbl,
  ) => void;

  readonly methodIntArray: (
    viewRef: React.ElementRef<NativeType>,
    a: Array<CodegenTypes.Int32>,
  ) => void;
  readonly methodStringArray: (
    viewRef: React.ElementRef<NativeType>,
    a: Array<string>,
  ) => void;
  readonly methodBoolArray: (
    viewRef: React.ElementRef<NativeType>,
    a: Array<boolean>,
  ) => void;
  readonly methodFloatArray: (
    viewRef: React.ElementRef<NativeType>,
    a: Array<CodegenTypes.Float>,
  ) => void;
  readonly methodDoubleArray: (
    viewRef: React.ElementRef<NativeType>,
    a: Array<CodegenTypes.Double>,
  ) => void;
  readonly methodCustomObjArray: (
    viewRef: React.ElementRef<NativeType>,
    a: Array<CustomObj>,
  ) => void;
  readonly methodCustomObj2Array: (
    viewRef: React.ElementRef<NativeType>,
    a: Array<CustomObj2>,
  ) => void;

  readonly methodRootTag: (
    viewRef: React.ElementRef<NativeType>,
    a: RootTag,
  ) => void;
}

export const Commands: NativeCommands = codegenNativeCommands<NativeCommands>({
  supportedCommands: [
    'methodInt',
    'methodIntString',
    'methodString',
    'methodBool',
    'methodFloat',
    'methodDouble',
    'methodIntAlias',
    'methodStringAlias',
    'methodBoolAlias',
    'methodFloatAlias',
    'methodDoubleAlias',
    'methodIntArray',
    'methodStringArray',
    'methodBoolArray',
    'methodFloatArray',
    'methodDoubleArray',
    'methodCustomObjArray',
    'methodCustomObj2Array',
    'methodRootTag',
  ],
});

export default codegenNativeComponent<NativeProps>(
  'NativeComponent',
) as NativeType;
