import type {CodegenTypes, HostComponent, ViewProps} from 'react-native';

import {codegenNativeComponent} from 'react-native';

export type Props = Readonly<{
  ...ViewProps,
  bool: boolean,
  string: string,
  double: CodegenTypes.Double,
  float: CodegenTypes.Float,
  int: CodegenTypes.Int32,
  stringUnion: CodegenTypes.WithDefault<'foo' | 'bar', 'bar'>,
  intUnion: CodegenTypes.WithDefault<1 | 2, 1>,
  mixed: unknown,

  backgroundColor?: CodegenTypes.WithDefault<string, 'transparent'>,
  height?: CodegenTypes.WithDefault<CodegenTypes.Int32, 100>,
}>;

export default codegenNativeComponent<Props>(
  'NativeComponent',
) as HostComponent<Props>;
