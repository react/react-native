  public void markDirtyAndPropagate();
  public void processDimensions();
  public void removeChild(size_t index);
  public void replaceChild(facebook::yoga::Node* child, size_t index);
  public void replaceChild(facebook::yoga::Node* oldChild, facebook::yoga::Node* newChild);
