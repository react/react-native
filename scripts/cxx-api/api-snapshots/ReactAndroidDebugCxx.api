  public void setLayoutBorder(float border, facebook::yoga::PhysicalEdge edge);
  public void setLayoutComputedFlexBasis(facebook::yoga::FloatOptional computedFlexBasis);
  public void setLayoutComputedFlexBasisGeneration(uint32_t computedFlexBasisGeneration);
