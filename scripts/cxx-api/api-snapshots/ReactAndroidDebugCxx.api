  public void setMinContentHeight(facebook::yoga::FloatOptional minContentHeight) noexcept;
  public void setMinContentMeasureFunc(YGMinContentMeasureFunc minContentMeasureFunc);
  public void setMinContentWidth(facebook::yoga::FloatOptional minContentWidth) noexcept;
